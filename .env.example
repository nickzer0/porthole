# Required: Password for accessing the application
# NOTE: leave blank to auto generate a password
PASSWORD=

# Optional: ngrok authentication token (recommended for stable URLs)
# Get your token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your-ngrok-token-here

# Optional: Port for the server (defaults to 8081)
PORT=8081

# Optional: AWS credentials for automatic CloudFront setup
# When provided, the app will automatically create a CloudFront distribution on first run
# and update it with new ngrok URLs on subsequent runs. This bypasses the ngrok browser warning.
# Get these from AWS IAM console (requires cloudfront:CreateDistribution, GetDistribution, UpdateDistribution, CreateInvalidation)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Auto-generated: CloudFront distribution ID (automatically added after first run)
# Leave this blank/commented out for automatic creation
# CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC

# Auto-generated: shared secret injected as a custom origin header on every
# request CloudFront forwards. The app uses it to tell CloudFront traffic apart
# from direct hits on the ngrok URL. Created on first run - do not edit or
# delete it, or the app will be unreachable through CloudFront until the new
# value propagates (~5 minutes).
# CLOUDFRONT_ORIGIN_SECRET=auto-generated-on-first-run

# Optional: IPs/CIDRs always allowed to reach the app, comma-separated.
# Merged with anything passed via --allow-ips. Bare IPs are treated as single
# hosts. Leave empty to disable IP restriction entirely.
# Browsing directly to http://localhost:PORT is always allowed regardless of
# this setting (tunnelled traffic is not, even though it also arrives from
# 127.0.0.1).
# TRUSTED_IPS=203.0.113.4,198.51.100.0/24

# Optional: Absolute path to the directory where uploaded files are stored
# Defaults to ./downloads (relative paths are resolved to absolute at startup)
DOWNLOADS_DIR=/path/to/downloads
